# ==========================================================
# CAREBUDDY ENVIRONMENT CONFIGURATION (.env)
# ==========================================================

# Flask Security & Environment
SECRET_KEY=change_this_to_a_long_cryptographically_secure_random_key_in_production
FLASK_ENV=development
FLASK_DEBUG=true

# Database (Strictly MySQL 8.0+ / PyMySQL)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=carebuddy_db

# Twilio Verify (SMS & WhatsApp OTP)
TWILIO_ENABLED=true
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_ENABLED=false

# Google Authentication (OAuth 2.0 / OpenID Connect)
GOOGLE_AUTH_ENABLED=true
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Facebook Login
FACEBOOK_AUTH_ENABLED=true
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_REDIRECT_URI=http://localhost:5000/auth/facebook/callback

# Sign in with Apple (Web)
APPLE_AUTH_ENABLED=true
APPLE_CLIENT_ID=your_apple_services_id
APPLE_TEAM_ID=your_apple_team_id
APPLE_KEY_ID=your_apple_key_id
APPLE_PRIVATE_KEY_PATH=/path/to/AuthKey_XXXXXXXXXX.p8
APPLE_REDIRECT_URI=http://localhost:5000/auth/apple/callback

# Session Cookie Security
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax

# Rate Limiting & Account Protection
AUTH_RATE_LIMIT_ENABLED=true
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15
